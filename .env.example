# Used by docker compose. Copy to .env and adjust; never commit .env.
# All values below are the defaults compose falls back to when .env is absent.

# Database (local demo credentials only — use real secrets in any shared deployment)
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=dhaka_tesla

# Host ports (change if something on your machine already uses them)
DB_HOST_PORT=5440
API_HOST_PORT=4000

# API
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
# Session signing key: any random 32+ character string, e.g. from `openssl rand -hex 32`
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_TTL_HOURS=12
# true only when served over HTTPS
COOKIE_SECURE=false
# Run the idempotent seed (story cast + route stops) on every API start
SEED_ON_START=true
