# Local development without Docker (copy to api/.env).
# For docker compose, use the .env.example at the repository root instead.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tesla:tesla@localhost:5440/dhaka_tesla
# Any random string of 32+ characters, e.g. from: openssl rand -hex 32
JWT_SECRET=local-dev-only-secret-change-me-0123456789
JWT_TTL_HOURS=12
# Browsers only send Secure cookies over HTTPS; plain http://localhost needs false
COOKIE_SECURE=false
# A ride request nobody accepts within this many seconds expires
REQUEST_TIMEOUT_SECONDS=300
